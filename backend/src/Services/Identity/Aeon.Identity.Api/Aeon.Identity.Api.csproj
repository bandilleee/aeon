<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Security & Code Quality -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- API documentation -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />

    <!-- Rate limiting is built into .NET 7+, no extra package needed -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\Aeon.BuildingBlocks.Web\Aeon.BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\Aeon.Identity.Application\Aeon.Identity.Application.csproj" />
    <ProjectReference Include="..\Aeon.Identity.Infrastructure\Aeon.Identity.Infrastructure.csproj" />
  </ItemGroup>

</Project>