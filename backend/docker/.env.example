# ===========================================
# Aeon Docker Environment Configuration
# ===========================================
# Copy this file to .env and update the values

# Database Configuration
POSTGRES_USER=aeon
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=aeon_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long-change-me
JWT_ISSUER=aeon-identity
JWT_AUDIENCE=aeon-app

# API Configuration
API_PORT=7039

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:7039

# Redis Configuration
REDIS_PASSWORD=

# Optional: reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
