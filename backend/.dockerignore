# ===========================================
# Docker Ignore - Backend
# ===========================================

# Build outputs
**/bin/
**/obj/
**/out/

# IDE and editor files
**/.vs/
**/.vscode/
**/.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Test results
**/TestResults/
**/coverage/

# NuGet
**/packages/

# Logs
**/*.log
**/logs/

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
!README.md

# Local environment files
.env
.env.*
!.env.example

# Docker files (we're inside docker context)
docker/docker-compose*.yml

# OS files
.DS_Store
Thumbs.db
